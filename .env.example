# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# In production, set these in your Vercel project > Settings > Environment Variables.

# --- NVIDIA (chatbot LLM) ---
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# --- Supabase (backend storage) ---
# Project Settings > API. Chat + booking work without these; nothing is just saved.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role key (server-side only)
