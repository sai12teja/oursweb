# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# In production, set these in your Vercel project > Settings > Environment Variables.

NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Optional: set to persist conversations in MongoDB (e.g. MongoDB Atlas free tier).
# Chat works without it; without a URI, conversations just aren't saved.
MONGODB_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=agentra
