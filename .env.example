# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# In production, set these in your Vercel project > Settings > Environment Variables.

# --- NVIDIA (chatbot LLM) ---
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# --- Storage: set ONE provider. Priority: Supabase > Firebase > Mongo.
#     Chat + booking work without any of these; nothing is just saved. ---

# Supabase (recommended). Create a project, run the SQL in README, then:
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # service_role key (server-side only)

# Firebase (opt-in): run `npm i firebase-admin`, then from a service-account JSON:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# MongoDB (fallback):
# MONGODB_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=agentra

# Optional: force a provider regardless of the above.
# STORAGE_PROVIDER=supabase   # supabase | firebase | mongo | none
